{
  "name": "@skidpad/validate",
  "version": "0.8.0",
  "private": true,
  "description": "Headless validation runner: standard manoeuvres with golden-result regression checks.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "skidpad-validate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx src/cli.ts",
    "validate:update": "tsx src/cli.ts --update",
    "test": "vitest run"
  },
  "dependencies": {
    "@skidpad/core": "workspace:*",
    "@skidpad/presets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
