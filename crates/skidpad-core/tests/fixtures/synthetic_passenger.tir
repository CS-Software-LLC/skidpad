RVY1                     = 0.0
RVY2                     = 0.0
RVY3                     = 0.0
RVY4                     = 0.0
RVY5                     = 1.9
RVY6                     = -10.0
PTY1                     = 1.5                  $ transient, ignored by the subset
[ALIGNING_COEFFICIENTS]
QBZ1                     = 9.0
QBZ2                     = -1.0
QBZ3                     = 0.0
QBZ4                     = 0.0
QBZ5                     = 0.0
QBZ9                     = 10.0
QBZ10                    = 0.0
QCZ1                     = 1.15
QDZ1                     = 0.11
QDZ2                     = -0.01
