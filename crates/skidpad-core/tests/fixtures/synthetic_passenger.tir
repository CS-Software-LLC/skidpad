$-------------------------------------------------------------------------------
$ Synthetic Magic Formula 5.2 (PAC2002) parameter set for a generic passenger
$ tire. Written for the Skidpad project; NOT measured data. See
$ data/PROVENANCE.md. Licensed MIT OR Apache-2.0.
$-------------------------------------------------------------------------------
[MDI_HEADER]
FILE_TYPE                ='tir'
FILE_VERSION             = 3.0
FILE_FORMAT              ='ASCII'
[UNITS]
LENGTH                   ='meter'
FORCE                    ='newton'
ANGLE                    ='radians'
MASS                     ='kg'
TIME                     ='second'
[MODEL]
PROPERTY_FILE_FORMAT     ='PAC2002'
USE_MODE                 = 4                    $ combined slip, no turn slip
LONGVL                   = 16.7                 $ reference speed
[DIMENSION]
UNLOADED_RADIUS          = 0.316
WIDTH                    = 0.205                $ ignored by the subset
ASPECT_RATIO             = 0.55                 $ ignored by the subset
RIM_RADIUS               = 0.2032               $ ignored by the subset
[VERTICAL]
FZ0                      = 4500
VERTICAL_STIFFNESS       = 210000               $ ignored by the subset
[SCALING_COEFFICIENTS]
LFZO                     = 1
LCX                      = 1
LMUX                     = 1
LEX                      = 1
LKX                      = 1
LHX                      = 1
LVX                      = 1
LCY                      = 1
LMUY                     = 1
LEY                      = 1
LKY                      = 1
LHY                      = 1
LVY                      = 1
LGAY                     = 1
LTR                      = 1
LRES                     = 1
LGAZ                     = 1
LXAL                     = 1
LYKA                     = 1
LVYKA                    = 1
LS                       = 1
LMX                      = 1
LVMX                     = 1
LMY                      = 1
[LONGITUDINAL_COEFFICIENTS]
PCX1                     = 1.65
PDX1                     = 1.05
PDX2                     = -0.09
PDX3                     = 0
PEX1                     = 0.35
PEX2                     = -0.05
PEX3                     = 0
PEX4                     = 0
PKX1                     = 23.0
PKX2                     = 2.0
PKX3                     = -0.25
PHX1                     = 0.0
PHX2                     = 0.0
PVX1                     = 0.0
PVX2                     = 0.0
RBX1                     = 11.0
RBX2                     = 9.5
RCX1                     = 1.0
REX1                     = 0.0
REX2                     = 0.0
RHX1                     = 0.0
PTX1                     = 1.2                  $ transient, ignored by the subset
[LATERAL_COEFFICIENTS]
PCY1                     = 1.35
PDY1                     = 1.0
PDY2                     = -0.12
PDY3                     = 0
PEY1                     = -0.9
PEY2                     = -0.1
PEY3                     = 0
PEY4                     = 0
