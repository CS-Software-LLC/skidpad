{
  "name": "@skidpad/rapier",
  "version": "0.8.0",
  "description": "Rapier 3D host adapter for Skidpad: drives a Rapier rigid body with the Skidpad four-wheel vehicle model.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CS-Software-LLC/skidpad",
    "directory": "packages/rapier"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@skidpad/core": "workspace:^"
  },
  "peerDependencies": {
    "@dimforge/rapier3d-compat": ">=0.14.0",
    "@dimforge/rapier3d-deterministic-compat": ">=0.14.0"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d-compat": {
      "optional": true
    },
    "@dimforge/rapier3d-deterministic-compat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@dimforge/rapier3d-deterministic-compat": "^0.21.0",
    "@skidpad/presets": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "vehicle",
    "physics",
    "rapier",
    "wasm"
  ]
}
