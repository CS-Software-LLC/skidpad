{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skidpad.dev/schema/vehicle-definition.schema.json",
  "title": "Skidpad vehicle definition",
  "description": "A vehicle as plain data: chassis, axles with tires and suspension, steering, brakes, drivetrain, assists, aero, and simulation settings. All units SI unless the field name ends in Deg. Every field has a default; a definition may omit any of them.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1,
      "description": "Format version. Migrations in @skidpad/core bring older files forward."
    },
    "name": {
      "type": "string",
      "default": "Unnamed vehicle"
    },
    "chassis": {
      "type": "object",
      "properties": {
        "mass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1300,
          "description": "Total mass, kg"
        },
        "yawInertia": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2000,
          "description": "Yaw inertia about the centre of mass, kg·m²"
        },
        "rollInertia": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 500,
          "description": "Roll inertia about the centre of mass, kg·m² (four-wheel model)"
        },
        "pitchInertia": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1800,
          "description": "Pitch inertia about the centre of mass, kg·m² (four-wheel model)"
        },
        "wheelbase": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.6,
          "description": "Wheelbase, m"
        },
        "cgToFrontAxle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.15,
          "description": "Front axle to centre of mass, m. Must be less than the wheelbase."
        },
        "cgHeight": {
          "type": "number",
          "minimum": 0,
          "default": 0.5,
          "description": "Centre-of-mass height, m. Drives longitudinal load transfer."
        },
        "trackWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.55,
          "description": "Track width, m"
        }
      },
      "additionalProperties": false
    },
    "axles": {
      "type": "array",
      "description": "Front axle first, rear second.",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/axle"
      }
    },
    "steering": {
      "type": "object",
      "properties": {
        "maxWheelAngleDeg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90,
          "default": 35,
          "description": "Maximum road-wheel angle, degrees"
        },
        "ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 14,
          "description": "Hand-wheel degrees per road-wheel degree"
        },
        "ackermann": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Ackermann fraction: 0 parallel steer, 1 ideal Ackermann (four-wheel model)"
        },
        "mechanicalTrail": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5,
          "default": 0.02,
          "description": "Mechanical (caster) trail on the ground, m (ADR-0012)"
        },
        "scrubRadius": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5,
          "default": 0.01,
          "description": "Scrub radius, m, positive with the contact outboard of the kingpin axis"
        },
        "steeringArm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.12,
          "description": "Knuckle arm the rack pulls on, m"
        },
        "powerAssist": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Fraction of the rack torque the assist removes at the hand wheel"
        },
        "columnFriction": {
          "type": "number",
          "minimum": 0,
          "default": 0.3,
          "description": "Column friction for the force-feedback device, N·m"
        },
        "columnDamping": {
          "type": "number",
          "minimum": 0,
          "default": 0.05,
          "description": "Column damping for the force-feedback device, N·m per rad/s"
        },
        "jackingRate": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5,
          "default": 0,
          "description": "Front contact travel along its ray per radian of steer, m/rad (inner down, outer up)"
        }
      },
      "additionalProperties": false
    },
    "brakes": {
      "type": "object",
      "properties": {
        "handbrakeTorque": {
          "type": "number",
          "minimum": 0,
          "default": 1500,
          "description": "Rear-axle handbrake torque, N·m"
        }
      },
      "additionalProperties": false
    },
    "drivetrain": {
      "type": "object",
      "description": "Power unit, transmission and differentials (ADR-0011). Which axles it drives comes from axles[].driven.",
      "properties": {
        "powerUnit": {
          "description": "What turns the carrier.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "direct"
                },
                "maxWheelTorque": {
                  "type": "number",
                  "minimum": 0,
                  "default": 2200,
                  "description": "Carrier torque at full throttle and rest, N·m, shared by the driven wheels"
                },
                "maxWheelSpeed": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 160,
                  "description": "Carrier speed where the torque reaches zero, rad/s"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "combustion"
                },
                "idleRpm": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 850,
                  "description": "Idle speed, rpm"
                },
                "redlineRpm": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 6500,
                  "description": "Rev limiter, rpm"
                },
                "inertia": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 0.25,
                  "description": "Crank, flywheel and clutch cover inertia, kg·m²"
                },
                "torqueCurve": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "default": [
                    [1000, 120],
                    [2000, 160],
                    [3500, 180],
                    [4500, 178],
                    [5500, 165],
                    [6500, 140]
                  ],
                  "description": "Full-throttle torque curve as [rpm, N·m] points in increasing rpm"
                },
                "engineBrakingIdle": {
                  "type": "number",
                  "minimum": 0,
                  "default": 15,
                  "description": "Closed-throttle drag torque at idle, N·m"
                },
                "engineBrakingRedline": {
                  "type": "number",
                  "minimum": 0,
                  "default": 60,
                  "description": "Closed-throttle drag torque at redline, N·m"
                },
                "idleTorqueMax": {
                  "type": "number",
                  "minimum": 0,
                  "default": 60,
                  "description": "Most torque the idle governor adds below idle, N·m"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "electric"
                },
                "maxTorque": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 300,
                  "description": "Peak motor torque, N·m"
                },
                "maxPower": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 150000,
                  "description": "Peak power, W"
                },
                "maxRpm": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 12000,
                  "description": "Speed where the torque has faded to zero, rpm"
                },
                "inertia": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 0.05,
                  "description": "Rotor inertia, kg·m²"
                },
                "regenTorque": {
                  "type": "number",
                  "minimum": 0,
                  "default": 60,
                  "description": "Regenerative braking torque on a closed throttle, N·m"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            }
          ]
        },
        "transmission": {
          "type": "object",
          "properties": {
            "gears": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "default": [1],
              "description": "Forward ratios, first gear first"
            },
            "reverse": {
              "type": "number",
              "minimum": 0,
              "default": 0,
              "description": "Reverse ratio magnitude; 0 means none"
            },
            "finalDrive": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "mode": {
              "type": "string",
              "enum": ["automatic", "manual"],
              "default": "automatic"
            },
            "shiftTime": {
              "type": "number",
              "minimum": 0,
              "default": 0.25,
              "description": "Torque interruption while changing gear, s"
            },
            "shiftHold": {
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "description": "Time after a shift before the automatic shifts again, s"
            },
            "shiftUpAt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.05,
              "default": 0.9,
              "description": "Automatic upshift point as a fraction of redline"
            },
            "shiftDownAt": {
              "type": "number",
              "minimum": 0,
              "default": 0.45,
              "description": "Automatic downshift point as a fraction of redline"
            },
            "clutchMaxTorque": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 400,
              "description": "Largest torque the clutch transmits, N·m"
            },
            "clutchEngageTime": {
              "type": "number",
              "minimum": 0,
              "default": 0.3,
              "description": "Clutch re-engagement time after a shift, s"
            },
            "clutchBiteRpm": {
              "type": "number",
              "minimum": 0,
              "default": 1200,
              "description": "The automatic clutch bites from idle to this many rpm above idle; 0 disables it"
            },
            "inputInertia": {
              "type": "number",
              "minimum": 0,
              "default": 0.05,
              "description": "Gearbox input and clutch disc inertia, kg·m²"
            },
            "outputInertia": {
              "type": "number",
              "minimum": 0,
              "default": 0.05,
              "description": "Gearbox output and propshaft inertia, kg·m²"
            }
          },
          "additionalProperties": false
        },
        "front": {
          "$ref": "#/$defs/differential"
        },
        "rear": {
          "$ref": "#/$defs/differential"
        },
        "center": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["open", "locked", "lsd"],
              "default": "open"
            },
            "frontTorqueFraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1,
              "default": 0.4,
              "description": "Share of the carrier torque sent to the front axle when open"
            },
            "preload": {
              "type": "number",
              "minimum": 0,
              "default": 0
            },
            "biasDrive": {
              "type": "number",
              "minimum": 1,
              "default": 2
            },
            "biasCoast": {
              "type": "number",
              "minimum": 1,
              "default": 1.5
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "assists": {
      "type": "object",
      "description": "Driving assists (ADR-0013), off by default. Stateless, applied inside the core so replays reproduce them.",
      "properties": {
        "abs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "slipTarget": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.12,
              "description": "Braking slip ratio where modulation starts"
            },
            "slipRelease": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.3,
              "description": "Braking slip ratio where the brake is at its floor"
            },
            "floor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.15,
              "description": "Smallest fraction of brake capacity left to the wheel"
            },
            "minSpeed": {
              "type": "number",
              "minimum": 0,
              "default": 2,
              "description": "Below this speed wheels may lock, m/s"
            }
          },
          "additionalProperties": false
        },
        "tractionControl": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "slipTarget": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.1
            },
            "slipRelease": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.25
            }
          },
          "additionalProperties": false
        },
        "stabilityControl": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "default": 1500,
              "description": "Brake torque per rad/s of yaw-rate error, N·m/(rad/s)"
            },
            "deadBand": {
              "type": "number",
              "minimum": 0,
              "default": 0.05,
              "description": "Yaw-rate error ignored, rad/s"
            },
            "throttleCut": {
              "type": "number",
              "minimum": 0,
              "default": 1,
              "description": "Throttle cut per rad/s of error"
            },
            "minSpeed": {
              "type": "number",
              "minimum": 0,
              "default": 3
            }
          },
          "additionalProperties": false
        },
        "steeringAssist": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "latAccelLimit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 9,
              "description": "Lateral acceleration the steering limit aims for, m/s²"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "aero": {
      "type": "object",
      "properties": {
        "dragCoefficient": {
          "type": "number",
          "minimum": 0,
          "default": 0.32
        },
        "frontalArea": {
          "type": "number",
          "minimum": 0,
          "default": 2.2,
          "description": "m²"
        },
        "airDensity": {
          "type": "number",
          "minimum": 0,
          "default": 1.225,
          "description": "kg/m³"
        }
      },
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "properties": {
        "substepRateHz": {
          "type": "number",
          "minimum": 60,
          "maximum": 10000,
          "default": 1000,
          "description": "Internal substep rate, Hz"
        },
        "model": {
          "type": "string",
          "enum": ["fourWheel", "singleTrack"],
          "default": "fourWheel",
          "description": "Vehicle model: four wheels on independent suspension over a 6-DOF chassis proxy, or the planar single-track model"
        }
      },
      "additionalProperties": false
    },
    "dataSheet": {
      "type": "object",
      "description": "Provenance for reference vehicles.",
      "properties": {
        "description": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "axle": {
      "type": "object",
      "properties": {
        "tire": {
          "$ref": "#/$defs/tire"
        },
        "wheelInertia": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.4,
          "description": "kg·m² per wheel including its share of the drivetrain"
        },
        "driven": {
          "type": "boolean"
        },
        "steered": {
          "type": "boolean"
        },
        "maxBrakeTorque": {
          "type": "number",
          "minimum": 0,
          "description": "Service-brake torque for the whole axle, N·m"
        },
        "staticCamberDeg": {
          "type": "number",
          "minimum": -45,
          "maximum": 45,
          "default": 0,
          "description": "Negative leans the top of each wheel toward the centreline"
        },
        "suspension": {
          "$ref": "#/$defs/suspension"
        }
      },
      "additionalProperties": false
    },
    "tire": {
      "oneOf": [
        {
          "$ref": "#/$defs/feelTire"
        },
        {
          "$ref": "#/$defs/magicFormulaTire"
        }
      ]
    },
    "feelTire": {
      "type": "object",
      "description": "Feel model (ADR-0008): tune by peak slip, peak grip, falloff, and stiffness.",
      "properties": {
        "model": {
          "const": "feel"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.31,
          "description": "m"
        },
        "nominalLoad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 4000,
          "description": "N"
        },
        "peakFriction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.0
        },
        "loadSensitivity": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.1
        },
        "peakSlipRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.12,
          "description": "Slip ratio at which longitudinal force peaks, in drive and in brake"
        },
        "peakSlipAngleDeg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 45,
          "default": 7,
          "description": "deg"
        },
        "longitudinalStiffness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 22,
          "description": "dFx/dκ / Fz0"
        },
        "corneringStiffness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 18,
          "description": "dFy/dα / Fz0, 1/rad"
        },
        "stiffnessPeakLoad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 8000,
          "description": "N"
        },
        "falloffLong": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.85
        },
        "falloffLat": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.85
        },
        "camberStiffness": {
          "type": "number",
          "minimum": 0,
          "default": 0.8,
          "description": "1/rad"
        },
        "pneumaticTrail": {
          "type": "number",
          "minimum": 0,
          "default": 0.03,
          "description": "m, trail at zero slip"
        },
        "trailZeroCrossing": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5,
          "default": 1,
          "description": "Equivalent slip angle at which the trail crosses zero, as a multiple of peakSlipAngleDeg (ADR-0008)"
        },
        "trailReversal": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.1,
          "description": "Depth of the negative trail lobe past the zero crossing, as a fraction of pneumaticTrail (ADR-0008)"
        },
        "fxMomentArm": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0,
          "description": "m per unit of Fy / nominalLoad: lateral offset of the longitudinal force that adds s·Fx to the aligning moment (Magic Formula SSZ2). Zero disables it."
        },
        "rollingResistance": {
          "type": "number",
          "minimum": 0,
          "default": 0.012
        },
        "relaxationLengthLong": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.25,
          "description": "m"
        },
        "relaxationLengthLat": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.35,
          "description": "m"
        },
        "lowSpeedFloor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.5,
          "description": "m/s. Speed floor of the kinematic slip (telemetry and the standstill deflection bound, ADR-0005); the deflection transient decays at the true rolling speed (ADR-0010)"
        },
        "lowSpeedDamping": {
          "type": "number",
          "minimum": 0,
          "default": 0.7,
          "description": "Damping ratio of the contact-patch spring on the corner mass at standstill (ADR-0010)"
        },
        "lowSpeedDampingFade": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2,
          "description": "m/s. Rolling speed at which the low-speed damping has faded to zero (ADR-0010)"
        }
      },
      "required": ["model"],
      "additionalProperties": false
    },
    "magicFormulaTire": {
      "type": "object",
      "description": "Magic Formula 5.2 subset. Coefficient keys are lower-cased .tir names.",
      "properties": {
        "model": {
          "const": "magicFormula"
        },
        "unloadedRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.31
        },
        "fz0": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 4000
        },
        "longvl": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 16.7
        },
        "relaxationLengthLong": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.25
        },
        "relaxationLengthLat": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.35
        },
        "lowSpeedFloor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.5
        },
        "lowSpeedDamping": {
          "type": "number",
          "minimum": 0,
          "default": 0.7
        },
        "lowSpeedDampingFade": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2
        }
      },
      "required": ["model"],
      "additionalProperties": {
        "type": "number"
      }
    },
    "suspension": {
      "type": "object",
      "description": "One corner's spring, damper, travel limits and the axle's anti-roll bar (ADR-0009). Per wheel. Defaults shown are the front axle's; the rear defaults are a little softer.",
      "properties": {
        "springRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 28000,
          "description": "N/m at the wheel"
        },
        "bumpDamping": {
          "type": "number",
          "minimum": 0,
          "default": 2500,
          "description": "N·s/m in compression"
        },
        "reboundDamping": {
          "type": "number",
          "minimum": 0,
          "default": 3500,
          "description": "N·s/m in extension"
        },
        "travelBump": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.08,
          "description": "m of compression travel from static ride height"
        },
        "travelDroop": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.1,
          "description": "m of extension travel from static ride height"
        },
        "antiRollStiffness": {
          "type": "number",
          "minimum": 0,
          "default": 15000,
