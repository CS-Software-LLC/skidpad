{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skidpad.dev/schema/vehicle-definition.schema.json",
  "title": "Skidpad vehicle definition",
  "description": "A vehicle as plain data: chassis, axles with tires and suspension, steering, brakes, drive, aero, and simulation settings. All units SI unless the field name ends in Deg. Every field has a default; a definition may omit any of them.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1,
      "description": "Format version. Migrations in @skidpad/core bring older files forward."
    },
    "name": {
      "type": "string",
      "default": "Unnamed vehicle"
    },
    "chassis": {
      "type": "object",
      "properties": {
        "mass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1300,
          "description": "Total mass, kg"
        },
        "yawInertia": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2000,
          "description": "Yaw inertia about the centre of mass, kg·m²"
        },
        "rollInertia": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 500,
          "description": "Roll inertia about the centre of mass, kg·m² (four-wheel model)"
        },
        "pitchInertia": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1800,
          "description": "Pitch inertia about the centre of mass, kg·m² (four-wheel model)"
        },
        "wheelbase": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.6,
          "description": "Wheelbase, m"
        },
        "cgToFrontAxle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.15,
          "description": "Front axle to centre of mass, m. Must be less than the wheelbase."
        },
        "cgHeight": {
          "type": "number",
          "minimum": 0,
          "default": 0.5,
          "description": "Centre-of-mass height, m. Drives longitudinal load transfer."
        },
        "trackWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.55,
          "description": "Track width, m"
        }
      },
      "additionalProperties": false
    },
    "axles": {
      "type": "array",
      "description": "Front axle first, rear second.",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/axle"
      }
    },
    "steering": {
      "type": "object",
      "properties": {
        "maxWheelAngleDeg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90,
          "default": 35,
          "description": "Maximum road-wheel angle, degrees"
        },
        "ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 14,
          "description": "Hand-wheel degrees per road-wheel degree"
        },
        "ackermann": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Ackermann fraction: 0 parallel steer, 1 ideal Ackermann (four-wheel model)"
        }
      },
      "additionalProperties": false
    },
    "brakes": {
      "type": "object",
      "properties": {
        "handbrakeTorque": {
          "type": "number",
          "minimum": 0,
          "default": 1500,
          "description": "Rear-axle handbrake torque, N·m"
        }
      },
      "additionalProperties": false
    },
    "drive": {
      "type": "object",
      "description": "Interim drive model until the drivetrain graph lands in milestone 4.",
      "properties": {
        "maxWheelTorque": {
          "type": "number",
          "minimum": 0,
          "default": 2200,
          "description": "Total wheel torque at full throttle, N·m"
        },
        "maxWheelSpeed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 160,
          "description": "Wheel speed where drive torque reaches zero, rad/s"
        }
      },
      "additionalProperties": false
    },
    "aero": {
      "type": "object",
      "properties": {
        "dragCoefficient": {
          "type": "number",
          "minimum": 0,
          "default": 0.32
        },
        "frontalArea": {
          "type": "number",
          "minimum": 0,
          "default": 2.2,
          "description": "m²"
        },
        "airDensity": {
          "type": "number",
          "minimum": 0,
          "default": 1.225,
          "description": "kg/m³"
        }
      },
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "properties": {
        "substepRateHz": {
          "type": "number",
          "minimum": 60,
          "maximum": 10000,
          "default": 1000,
          "description": "Internal substep rate, Hz"
        },
        "model": {
          "type": "string",
          "enum": ["fourWheel", "singleTrack"],
          "default": "fourWheel",
          "description": "Vehicle model: four wheels on independent suspension over a 6-DOF chassis proxy, or the planar single-track model"
        }
      },
      "additionalProperties": false
    },
    "dataSheet": {
      "type": "object",
      "description": "Provenance for reference vehicles.",
      "properties": {
        "description": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "axle": {
      "type": "object",
      "properties": {
        "tire": {
          "$ref": "#/$defs/tire"
        },
        "wheelInertia": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.4,
          "description": "kg·m² per wheel including its share of the drivetrain"
        },
        "driven": {
          "type": "boolean"
        },
        "steered": {
          "type": "boolean"
        },
        "maxBrakeTorque": {
          "type": "number",
          "minimum": 0,
          "description": "Service-brake torque for the whole axle, N·m"
        },
        "staticCamberDeg": {
          "type": "number",
          "minimum": -45,
          "maximum": 45,
          "default": 0,
          "description": "Negative leans the top of each wheel toward the centreline"
        },
        "suspension": {
          "$ref": "#/$defs/suspension"
        }
      },
      "additionalProperties": false
    },
    "tire": {
      "oneOf": [
        {
          "$ref": "#/$defs/feelTire"
        },
        {
          "$ref": "#/$defs/magicFormulaTire"
        }
      ]
    },
    "feelTire": {
      "type": "object",
      "description": "Feel model (ADR-0008): tune by peak slip, peak grip, falloff, and stiffness.",
      "properties": {
        "model": {
          "const": "feel"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.31,
          "description": "m"
        },
        "nominalLoad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 4000,
          "description": "N"
        },
        "peakFriction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.0
        },
        "loadSensitivity": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.1
        },
        "peakSlipRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.12
        },
        "peakSlipAngleDeg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 7
        },
        "longitudinalStiffness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 22,
          "description": "dFx/dκ / Fz0"
        },
        "corneringStiffness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 18,
          "description": "dFy/dα / Fz0, 1/rad"
        },
        "stiffnessPeakLoad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 8000,
          "description": "N"
        },
        "falloffLong": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.85
        },
        "falloffLat": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.85
        },
        "camberStiffness": {
          "type": "number",
          "minimum": 0,
          "default": 0.8,
          "description": "1/rad"
        },
        "pneumaticTrail": {
          "type": "number",
          "minimum": 0,
          "default": 0.03,
          "description": "m"
        },
        "rollingResistance": {
          "type": "number",
          "minimum": 0,
          "default": 0.012
        },
        "relaxationLengthLong": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.25,
          "description": "m"
        },
        "relaxationLengthLat": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.35,
          "description": "m"
        },
        "lowSpeedFloor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.5,
          "description": "m/s"
        },
        "lowSpeedDamping": {
          "type": "number",
          "minimum": 0,
          "default": 0.3,
          "description": "Damping ratio of the wheel-tire mode below the speed floor (ADR-0005)"
        }
      },
      "required": ["model"],
      "additionalProperties": false
    },
    "magicFormulaTire": {
      "type": "object",
      "description": "Magic Formula 5.2 subset. Coefficient keys are lower-cased .tir names.",
      "properties": {
        "model": {
          "const": "magicFormula"
        },
        "unloadedRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.31
        },
        "fz0": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 4000
        },
        "longvl": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 16.7
        },
        "relaxationLengthLong": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.25
        },
        "relaxationLengthLat": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.35
        },
        "lowSpeedFloor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.5
        },
        "lowSpeedDamping": {
          "type": "number",
          "minimum": 0,
          "default": 0.3
        }
      },
      "required": ["model"],
      "additionalProperties": {
        "type": "number"
      }
    },
    "suspension": {
      "type": "object",
      "description": "One corner's spring, damper, travel limits and the axle's anti-roll bar (ADR-0009). Per wheel. Defaults shown are the front axle's; the rear defaults are a little softer.",
      "properties": {
        "springRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 28000,
          "description": "N/m at the wheel"
        },
        "bumpDamping": {
          "type": "number",
          "minimum": 0,
          "default": 2500,
          "description": "N·s/m in compression"
        },
        "reboundDamping": {
          "type": "number",
          "minimum": 0,
          "default": 3500,
          "description": "N·s/m in extension"
        },
        "travelBump": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.08,
          "description": "m of compression travel from static ride height"
        },
        "travelDroop": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.1,
          "description": "m of extension travel from static ride height"
        },
        "antiRollStiffness": {
          "type": "number",
          "minimum": 0,
          "default": 15000,
          "description": "N/m: force on each wheel per metre of left-right travel difference"
        },
        "bumpStopStiffness": {
          "type": "number",
          "minimum": 0,
          "default": 300000,
          "description": "N/m beyond the bump travel"
        }
      },
      "additionalProperties": false
    }
  }
}
