{
  "name": "@skidpad/replay",
  "version": "0.5.0",
  "description": "Deterministic replays and lightweight ghosts for Skidpad: record inputs and keyframes, re-simulate, seek, and play back pose tracks.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CS-Software-LLC/skidpad",
    "directory": "packages/replay"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@skidpad/core": "workspace:^"
  },
  "devDependencies": {
    "@skidpad/presets": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "vehicle",
    "physics",
    "replay",
    "ghost",
    "deterministic"
  ]
}
